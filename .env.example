# Copy this file to .env and replace the placeholder values.
# NEVER commit .env (it is listed in .gitignore).

# --- Public values (copied into config.js for the browser) -------------
# Supabase Dashboard -> Project Settings -> API (or "Connect")
SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon public" (legacy) or "publishable" key. Safe to expose: RLS protects the data.
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Secret values (used ONLY by scripts/provision-studio.js on your computer) ---
# The "service_role" (legacy) or "secret" key. Bypasses RLS — never put it in config.js or the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# The initial studio admin account from seed.json.
STUDIO_EMAIL=studio@artstudio.in
# Use the password from seedData.zip's seed.json (or a stronger one). Never commit it.
STUDIO_PASSWORD=your-studio-password
